# X (Twitter) Login Credentials
X_USERNAME=your_username
X_PASSWORD=your_password
X_EMAIL=your_email@example.com

# Scheduled Post Settings
POSTS_PER_DAY=8

# Browser Settings
HEADLESS=true
SLOW_MO=100
BROWSER_TIMEOUT=30000

# YouTube Analysis (youtube_analysis/)
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional: Claude による所見・タイトル案生成を有効にする場合のみ
ANTHROPIC_API_KEY=
# Optional: 分析する動画数の上限 (デフォルト 100)
YT_MAX_VIDEOS=100
